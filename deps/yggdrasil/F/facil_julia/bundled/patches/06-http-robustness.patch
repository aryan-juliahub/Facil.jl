+/* True when a conditional header value names this (quoted) entity tag. */
+static int http_etag_listed(FIOBJ header, fio_str_info_s etag) {
+  if (!header)
+    return 0;
+  if (FIOBJ_TYPE_IS(header, FIOBJ_T_ARRAY))
+    header = fiobj_ary_index(header, 0);
+  fio_str_info_s v = fiobj_obj2cstr(header);
+  if (!v.data || !v.len)
+    return 0;
+  if (v.len == 1 && v.data[0] == '*')
+    return 1;
+  for (size_t i = 0; i + etag.len <= v.len; ++i)
+    if (v.data[i] == '"' && !memcmp(v.data + i, etag.data, etag.len))
+      return 1;
+  return 0;
+}
