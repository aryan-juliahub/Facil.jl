+/* Reads decimal digits, saturating at INT64_MAX. Returns -1 if there are none. */
+static int64_t http_range_num(const char **pos, const char *end) {
+  const char *p = *pos;
+  int64_t n = 0;
+  if (p >= end || *p < '0' || *p > '9')
+    return -1;
+  for (; p < end && *p >= '0' && *p <= '9'; ++p)
+    n = (n > (INT64_MAX - 9) / 10) ? INT64_MAX : (n * 10 + (*p - '0'));
+  *pos = p;
+  return n;
+}
+
+/* One `bytes=` range against a body of `size` bytes: 1 with start/len set,
+ * -1 when unsatisfiable, 0 when the header is to be ignored (bad syntax,
+ * another unit, or more than one range). */
+static int http_range_parse(fio_str_info_s r, int64_t size, int64_t *start,
+                            int64_t *len) {
+  if (!r.data || r.len < 7 || strncasecmp(r.data, "bytes=", 6))
+    return 0;
+  const char *p = r.data + 6;
+  const char *end = r.data + r.len;
+  while (p < end && (*p == ' ' || *p == '\t'))
+    ++p;
+  int64_t a = http_range_num(&p, end);
+  if (p >= end || *p != '-')
+    return 0;
+  ++p;
+  int64_t b = http_range_num(&p, end);
+  while (p < end && (*p == ' ' || *p == '\t'))
+    ++p;
+  if (p != end)
+    return 0;
+  if (a < 0) {
+    if (b < 0)
+      return 0;
+    if (!b || !size)
+      return -1;
+    if (b > size)
+      b = size;
+    *start = size - b;
+    *len = b;
+    return 1;
+  }
+  if (b >= 0 && b < a)
+    return 0;
+  if (a >= size)
+    return -1;
+  if (b < 0 || b >= size)
+    b = size - 1;
+  *start = a;
+  *len = b - a + 1;
+  return 1;
+}
