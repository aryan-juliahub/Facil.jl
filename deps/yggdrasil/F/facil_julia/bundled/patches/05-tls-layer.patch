+/**
+ * Sets protocol versions (`TLS1_2_VERSION`..., 0 for the default), the TLS 1.2
+ * cipher list and the TLS 1.3 ciphersuites (NULL for the library default) and
+ * the `FIO_TLS_*` flags.
+ *
+ * Returns -1, changing nothing, when OpenSSL rejects a value.
+ */
+int fio_tls_configure(fio_tls_s *tls, int min_version, int max_version,
+                      const char *ciphers, const char *suites, int flags) {
+  if (!tls)
+    return -1;
+  fio_tls_s old = *tls;
+  tls->min_version = min_version;
+  tls->max_version = max_version;
+  tls->ciphers = ciphers ? strdup(ciphers) : NULL;
+  tls->suites = suites ? strdup(suites) : NULL;
+  tls->flags = flags;
+  if (fio_tls_build_context(tls)) {
+    free(tls->ciphers);
+    free(tls->suites);
+    tls->min_version = old.min_version;
+    tls->max_version = old.max_version;
+    tls->ciphers = old.ciphers;
+    tls->suites = old.suites;
+    tls->flags = old.flags;
+    return -1;
+  }
+  free(old.ciphers);
+  free(old.suites);
+  return 0;
+}
