+/**
+ * Sets the certificate for `server_name` from PEM text, replacing the one that
+ * name already has. Connections accepted from now on use it; established ones
+ * are untouched.
+ *
+ * Returns -1, changing nothing, when OpenSSL rejects the certificate or key.
+ */
+int fio_tls_cert_set_pem(fio_tls_s *tls, const char *server_name,
+                         const char *cert_pem, size_t cert_len,
+                         const char *key_pem, size_t key_len,
+                         const char *pk_password) {
+  if (!tls || !server_name || !cert_pem || !key_pem)
+    return -1;
+  cert_s c = {
+      .name = FIO_STR_INIT,
+      .private_key = FIO_STR_INIT,
+      .public_key = FIO_STR_INIT,
+      .password = FIO_STR_INIT,
+  };
+  fio_str_write(&c.name, server_name, strlen(server_name));
+  fio_str_write(&c.private_key, key_pem, key_len);
+  fio_str_write(&c.public_key, cert_pem, cert_len);
+  if (pk_password)
+    fio_str_write(&c.password, pk_password, strlen(pk_password));
+
+  cert_ary_s old = tls->sni;
+  cert_ary_s next = FIO_ARY_INIT;
+  uint8_t replaced = 0;
+  FIO_ARY_FOR(&old, pos) {
+    if (!replaced && !strcasecmp(fio_str_data(&pos->name), server_name)) {
+      cert_ary_push(&next, c);
+      replaced = 1;
+    } else if (strcasecmp(fio_str_data(&pos->name), server_name)) {
+      cert_ary_push(&next, *pos);
+    }
+  }
+  if (!replaced)
+    cert_ary_push(&next, c);
+  fio_tls_cert_destroy(&c);
+  tls->sni = next;
+  if (fio_tls_build_context(tls)) {
+    tls->sni = old;
+    cert_ary_free(&next);
+    return -1;
+  }
+  cert_ary_free(&old);
+  return 0;
+}
