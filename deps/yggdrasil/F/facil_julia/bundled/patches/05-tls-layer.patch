+/* *****************************************************************************
+Spike switches (environment, read once)
+***************************************************************************** */
+
+/* FIO_TLS_READ_MODE: 0 socket BIO, 1 socket BIO with read-ahead, 2 own buffer.
+ * FIO_TLS_WRITE_CHUNK: plaintext bytes encrypted per socket write.
+ * FIO_TLS_HS_SPIN=1: poll for writability while a handshake waits for input.
+ * FIO_TLS_LINGER=1: after close_notify, wait for the peer to close first. */
+static int fio_tls_read_mode = 2;
+static size_t fio_tls_write_chunk = (1 << 17);
+static int fio_tls_hs_spin = 0;
+static int fio_tls_linger = 0;
+
+static void fio_tls_switches(void) {
+  static int done = 0;
+  if (done)
+    return;
+  done = 1;
+  const char *e;
+  if ((e = getenv("FIO_TLS_READ_MODE")))
+    fio_tls_read_mode = atoi(e);
+  if ((e = getenv("FIO_TLS_WRITE_CHUNK")) && atol(e) > 0)
+    fio_tls_write_chunk = (size_t)atol(e);
+  if ((e = getenv("FIO_TLS_HS_SPIN")))
+    fio_tls_hs_spin = atoi(e);
+  if ((e = getenv("FIO_TLS_LINGER")))
+    fio_tls_linger = atoi(e);
+}
