+static int fio_tls_bio_write(BIO *b, const char *data, int len) {
+  fio_tls_connection_s *c = BIO_get_data(b);
+  if (len <= 0)
+    return 0;
+  if (c->out_len + (size_t)len > c->out_capa) {
+    size_t capa = c->out_capa ? c->out_capa : 4096;
+    while (capa < c->out_len + (size_t)len)
+      capa <<= 1;
+    char *tmp = realloc(c->out, capa);
+    if (!tmp)
+      return -1;
+    c->out = tmp;
+    c->out_capa = capa;
+  }
+  memcpy(c->out + c->out_len, data, len);
+  c->out_len += len;
+  return len;
+}
+
+static int fio_tls_bio_read(BIO *b, char *dst, int len) {
+  fio_tls_connection_s *c = BIO_get_data(b);
+  BIO_clear_retry_flags(b);
+  if (len <= 0)
+    return 0;
+  if (c->in_pos == c->in_len) {
+    if (c->in_eof)
+      return 0;
+    if (!c->in && !(c->in = malloc(FIO_TLS_IN_CAPA)))
+      return -1;
+    ssize_t r;
+    do {
+      r = read(fio_uuid2fd(c->uuid), c->in, FIO_TLS_IN_CAPA);
+    } while (r < 0 && errno == EINTR);
+    if (r <= 0) {
+      /* an idle connection holds no input buffer */
+      free(c->in);
+      c->in = NULL;
+      c->in_pos = c->in_len = 0;
+      if (r == 0) {
+        c->in_eof = 1;
+        return 0;
+      }
+      if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ENOTCONN)
+        BIO_set_retry_read(b);
+      return -1;
+    }
+    c->in_pos = 0;
+    c->in_len = r;
+  }
+  size_t n = c->in_len - c->in_pos;
+  if (n > (size_t)len)
+    n = len;
+  memcpy(dst, c->in + c->in_pos, n);
+  c->in_pos += n;
+  return (int)n;
+}
+
+static long fio_tls_bio_ctrl(BIO *b, int cmd, long num, void *ptr) {
+  fio_tls_connection_s *c = BIO_get_data(b);
+  switch (cmd) {
+  case BIO_CTRL_FLUSH: /* the hooks send `out` after every OpenSSL call */
+  case BIO_CTRL_DUP:
+    return 1;
+  case BIO_CTRL_WPENDING:
+    return (long)(c->out_len - c->out_pos);
+  case BIO_CTRL_PENDING:
+    return (long)(c->in_len - c->in_pos);
+  case BIO_CTRL_EOF:
+    return c->in_eof;
+  }
+  return 0;
+  (void)num;
+  (void)ptr;
+}
+
+static BIO_METHOD *fio_tls_bio_method(void) {
+  static BIO_METHOD *m = NULL;
+  static fio_lock_i lock = FIO_LOCK_INIT;
+  fio_lock(&lock);
+  if (!m) {
+    m = BIO_meth_new(BIO_get_new_index() | BIO_TYPE_SOURCE_SINK, "facil.io");
+    FIO_ASSERT_ALLOC(m);
+    BIO_meth_set_write(m, fio_tls_bio_write);
+    BIO_meth_set_read(m, fio_tls_bio_read);
+    BIO_meth_set_ctrl(m, fio_tls_bio_ctrl);
+  }
+  fio_unlock(&lock);
+  return m;
+}
