+/* Sends `out` with one socket write. Returns 0 when it is empty, 1 when the
+ * socket is full, -1 (errno EPIPE) when the socket failed. */
+static int fio_tls_out_flush(fio_tls_connection_s *c) {
+  if (c->out_pos < c->out_len) {
+    ssize_t w;
+    do {
+      w = write(fio_uuid2fd(c->uuid), c->out + c->out_pos,
+                c->out_len - c->out_pos);
+    } while (w < 0 && errno == EINTR);
+    if (w < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ENOTCONN ||
+          errno == ENOBUFS)
+        return 1;
+      errno = EPIPE;
+      return -1;
+    }
+    c->out_pos += w;
+    if (c->out_pos < c->out_len)
+      return 1;
+  }
+  c->out_pos = c->out_len = 0;
+  if (c->out_capa > FIO_TLS_OUT_KEEP) {
+    free(c->out);
+    c->out = NULL;
+    c->out_capa = 0;
+  }
+  return 0;
+}
