+static int fio_tls_name_matches(const char *pattern, const char *name) {
+  if (!strcasecmp(pattern, name))
+    return 1;
+  const char *dot = strchr(name, '.');
+  return pattern[0] == '*' && pattern[1] == '.' && dot &&
+         !strcasecmp(pattern + 1, dot);
+}
+
+/* Switches the connection to the context whose name matches the SNI name. */
+static int fio_tls_sni_cb(SSL *ssl, int *alert, void *tls_) {
+  fio_tls_s *tls = tls_;
+  const char *name = SSL_get_servername(ssl, TLSEXT_NAMETYPE_host_name);
+  if (!name)
+    return SSL_TLSEXT_ERR_NOACK;
+  SSL_CTX *found = NULL;
+  fio_lock(&tls->lock);
+  for (size_t i = 0; i < tls->ctx_count && !found; ++i) {
+    if (fio_tls_name_matches(tls->names[i], name))
+      found = tls->ctxs[i];
+  }
+  if (found && found != SSL_get_SSL_CTX(ssl))
+    SSL_set_SSL_CTX(ssl, found);
+  fio_unlock(&tls->lock);
+  return found ? SSL_TLSEXT_ERR_OK : SSL_TLSEXT_ERR_NOACK;
+  (void)alert;
+}
