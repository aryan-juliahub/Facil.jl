+
+void http1_body_configure(http1_body_config_s cfg) {
+  if (!cfg.mem_limit)
+    cfg.mem_limit = 8u << 20;
+  if (cfg.read_chunk < HTTP_MAX_HEADER_LENGTH * 2)
+    cfg.read_chunk = 256u << 10;
+  h1_body_cfg = cfg;
+  h1_body_on = 1;
+}
+
+static void h1_body_clear(http1pr_s *p) {
+  if (p->body.mode == HTTP1_BODY_MALLOC && !p->body.taken)
+    free(p->body.data);
+  if (!p->body.delivered && h1_body_cfg.on_abort &&
+      (p->body.mode == HTTP1_BODY_EXTERN || p->body.mode == HTTP1_BODY_STREAM))
+    h1_body_cfg.on_abort(p->body.udata, p->body.mode);
+  if (p->body.fd >= 0)
+    close(p->body.fd);
+  if (p->body.path) {
+    if (!p->body.keep_file)
+      unlink(p->body.path);
+    free(p->body.path);
+  }
+  memset(&p->body, 0, sizeof(p->body));
+  p->body.fd = -1;
+  p->stop &= ~H1_STOP_BODY;
+}
+
+/* Answers and closes: the unread body makes the connection unusable. */
+static int h1_body_reject(http1pr_s *p, size_t status) {
+  http1_reject(p, status);
+  return -1;
+}
+
+static int h1_body_open_file(http1pr_s *p) {
+  char name[] = P_tmpdir "/facil_io_tmpfile_XXXXXXXX";
+  int fd = mkstemp(name);
+  if (fd < 0)
+    return -1;
+  p->body.fd = fd;
+  p->body.path = strdup(name);
+  p->body.mode = HTTP1_BODY_FILE;
+  p->body.want_big = 1;
+  return 0;
+}
+
+static int h1_body_write_file(http1pr_s *p, const uint8_t *data, size_t len) {
+  while (len) {
+    ssize_t n = write(p->body.fd, data, len);
+    if (n < 0) {
+      if (errno == EINTR)
+        continue;
+      return -1;
+    }
+    data += n;
+    len -= (size_t)n;
+    p->body.len += (size_t)n;
+  }
+  return 0;
+}
+
+/** called when the header block is complete, before any body byte. */
+static int http1_on_headers_complete(http1_parser_s *parser, size_t available) {
+  http1pr_s *p = parser2http(parser);
+  if (!h1_body_on || p->is_client)
+    return 0;
+  const long long clen = parser->state.content_length;
+  const int chunked = (parser->state.reserved & HTTP1_P_FLAG_CHUNKED) != 0;
+  if (!chunked && clen <= 0)
+    return 0;
+  if (!chunked && (unsigned long long)clen > p->p.settings->max_body_size)
+    return h1_body_reject(p, 413);
+  if (!chunked && (size_t)clen <= available) {
+    p->body.mode = HTTP1_BODY_VIEW;
+    return 0;
+  }
+  http_s *h = &p->request;
+  http1_body_plan_s plan = {
+      .mode = (!chunked && (size_t)clen > h1_body_cfg.mem_limit)
+                  ? HTTP1_BODY_FILE
+                  : HTTP1_BODY_MALLOC,
+      .mem_limit = h1_body_cfg.mem_limit};
+  if (h1_body_cfg.on_headers)
+    h1_body_cfg.on_headers(h, chunked ? -1 : clen, &plan);
+  if (plan.status)
+    return h1_body_reject(p, (size_t)plan.status);
+  p->body.udata = plan.udata;
+  p->body.mem_limit = plan.mem_limit;
+  switch (plan.mode) {
+  case HTTP1_BODY_EXTERN:
+    if (chunked || !plan.dest)
+      return h1_body_reject(p, 500);
+    p->body.mode = HTTP1_BODY_EXTERN;
+    p->body.data = plan.dest;
+    break;
+  case HTTP1_BODY_STREAM:
+    if (!h1_body_cfg.on_data)
+      return h1_body_reject(p, 500);
+    p->body.mode = HTTP1_BODY_STREAM;
+    p->body.want_big = 1;
+    break;
+  case HTTP1_BODY_FILE:
+    if (h1_body_open_file(p))
+      return h1_body_reject(p, 500);
+    break;
+  default:
+    p->body.mode = HTTP1_BODY_MALLOC;
+    if (chunked) {
+      p->body.want_big = 1;
+    } else if (!(p->body.data = malloc((size_t)clen))) {
+      return h1_body_reject(p, 500);
+    }
+  }
+  if (p->body.data) {
+    p->body.cap = (size_t)clen;
+    p->body.sized = 1;
+    p->body.direct = 1;
+  }
+  static uint64_t expect_hash;
+  if (!expect_hash)
+    expect_hash = fiobj_hash_string("expect", 6);
+  FIOBJ expect = fiobj_hash_get2(h->headers, expect_hash);
+  if (expect) {
+    fio_str_info_s v = fiobj_obj2cstr(expect);
+    if (v.len == 12 && !strncasecmp(v.data, "100-continue", 12))
+      fio_write2(p->p.uuid, .data.buffer = (void *)"HTTP/1.1 100 Continue\r\n\r\n",
+                 .length = 25, .after.dealloc = FIO_DEALLOC_NOOP);
+  }
+  return 0;
+}
