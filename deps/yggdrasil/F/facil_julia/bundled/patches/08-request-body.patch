+    return 0;
+  http1pr_s *p = handle2pr(h);
+  out->mode = p->body.mode;
+  out->fd = p->body.fd;
+  out->data = p->body.data;
+  out->len = p->body.len;
+  out->udata = p->body.udata;
+  out->path = p->body.path;
+  return out->mode;
