new file mode 100644
index 0000000..709f27a
--- /dev/null
+++ b/lib/facil/http/http1_body.h
@@ -0,0 +1,59 @@
+#ifndef H_HTTP1_BODY_H
+#define H_HTTP1_BODY_H
+/* Request-body delivery for the HTTP/1 server: where the bytes land, and the
+ * decisions that can be made as soon as the header block is complete. */
+#include <http.h>
+
+enum http1_body_mode_e {
+  HTTP1_BODY_NONE = 0,
+  HTTP1_BODY_VIEW = 1,   /* whole body inside the read buffer; valid only during on_request */
+  HTTP1_BODY_MALLOC = 2, /* one libc malloc block, exact size when the length is known */
+  HTTP1_BODY_EXTERN = 3, /* memory supplied by on_headers; never freed here */
+  HTTP1_BODY_STREAM = 4, /* handed to on_data piece by piece, never stored */
+  HTTP1_BODY_FILE = 5,   /* spooled to a temp file */
+};
+
+typedef struct {
+  int32_t mode;   /* in: the default for this request; out: the choice */
+  int32_t status; /* out: non-zero answers with this status and closes */
+  uint8_t *dest;  /* out, HTTP1_BODY_EXTERN: `content_length` writable bytes */
+  void *udata;    /* out: returned by http1_body_info and passed to on_data / on_abort */
+  size_t mem_limit; /* in: the configured limit; out: bytes a chunked body may hold in memory before it is moved to a file */
+} http1_body_plan_s;
+
+typedef struct {
+  /* Called when a request's headers are complete and its body is not yet all
+   * received. content_length is -1 for chunked bodies. */
+  void (*on_headers)(http_s *h, int64_t content_length, http1_body_plan_s *plan);
+  /* HTTP1_BODY_STREAM. Return 1 to stop reading the socket until http1_body_resume. */
+  int (*on_data)(http_s *h, void *udata, const uint8_t *data, size_t len);
+  /* The connection ended before on_request was called for this body. */
+  void (*on_abort)(void *udata, int32_t mode);
+  size_t mem_limit;  /* default plan: larger bodies go to a temp file */
+  size_t read_chunk; /* socket read size while streaming, spooling or un-chunking */
+} http1_body_config_s;
+
+/* Call once before the server starts. Without it the stock behaviour applies. */
+void http1_body_configure(http1_body_config_s cfg);
+
+typedef struct {
+  int32_t mode;
+  int32_t fd; /* HTTP1_BODY_FILE, else -1 */
+  uint8_t *data;
+  size_t len;
+  void *udata;
+  const char *path; /* HTTP1_BODY_FILE; removed when the request ends unless kept */
+} http1_body_info_s;
+
+/* Valid from on_request until the response is finished. Returns the mode. */
+int http1_body_info(http_s *h, http1_body_info_s *out);
+/* HTTP1_BODY_MALLOC: the caller now owns the block and must free() it. */
+uint8_t *http1_body_take(http_s *h);
+/* HTTP1_BODY_FILE: leave the file in place (the caller renamed or adopted it). */
+void http1_body_keep_file(http_s *h);
+/* Thread-safe. Resumes socket reads after on_data returned 1. */
+void http1_body_resume(intptr_t uuid);
+/* The connection's uuid, for http1_body_resume. */
+intptr_t http1_body_uuid(http_s *h);
+
+#endif
