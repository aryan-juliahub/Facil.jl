+
+uint8_t *http1_body_take(http_s *h) {
+  http1pr_s *p = handle2pr(h);
+  if (h != &p->request || p->body.mode != HTTP1_BODY_MALLOC || p->body.taken)
+    return NULL;
+  p->body.taken = 1;
+  return p->body.data;
+}
