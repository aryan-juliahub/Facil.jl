+/* Swaps in the large read buffer while a body wants it, and goes back to the
+ * built-in one as soon as what is left over fits there. */
+static void h1_rbuf_fit(http1pr_s *p) {
+  if (p->body.want_big) {
+    if (p->rbuf != p->buf)
+      return;
+    uint8_t *big = malloc(h1_body_cfg.read_chunk);
+    if (!big)
+      return;
+    memcpy(big, p->buf, p->buf_len);
+    p->rbuf = big;
+    p->rcap = h1_body_cfg.read_chunk;
+  } else if (p->rbuf != p->buf && p->buf_len <= HTTP_MAX_HEADER_LENGTH) {
+    memcpy(p->buf, p->rbuf, p->buf_len);
+    free(p->rbuf);
+    p->rbuf = p->buf;
+    p->rcap = HTTP_MAX_HEADER_LENGTH;
+  }
+}
+
+/* Reads the socket straight into the body's memory, exactly up to its end,
+ * so no byte of a following request is taken. 1 once the request was dispatched. */
+static int h1_body_read_direct(intptr_t uuid, http1pr_s *p) {
+  while (p->body.len < p->body.cap) {
+    const size_t ask = p->body.cap - p->body.len;
+    ssize_t n = fio_read(uuid, p->body.data + p->body.len, ask);
+    if (n <= 0)
+      return 0;
+    p->body.len += (size_t)n;
+    p->parser.state.read += n;
+    if ((size_t)n < ask)
+      return 0;
+  }
+  p->body.direct = 0;
+  p->parser.state.next = p->rbuf;
+  p->answered = 0;
+  http1_on_request(&p->parser);
+  p->parser.state = (struct http1_parser_protected_read_only_state_s){0};
+  return 1;
+}
