diff --git a/lib/facil/fio.c b/lib/facil/fio.c
index feded17..7a5b7fe 100644
--- a/lib/facil/fio.c
+++ b/lib/facil/fio.c
@@ -1915,6 +1915,29 @@ FIO_FUNC inline void fio_poll_remove_fd(intptr_t fd) {
 #define NOTE_CRITICAL 0
 #endif
 
+/* Read re-arms wait here and go to the kernel with the next poll's kevent
+ * call, saving a syscall each. While a thread is inside that call they are
+ * made at once, so none waits behind a blocked poll. */
+#define FIO_POLL_CHANGES 256
+static struct kevent fio_poll_changes[FIO_POLL_CHANGES];
+static int fio_poll_changes_n;
+static uint8_t fio_poll_waiting;
+static fio_lock_i fio_poll_changes_lock = FIO_LOCK_INIT;
+
+static inline void fio_poll_rearm_read(intptr_t fd) {
+  fio_lock(&fio_poll_changes_lock);
+  if (!fio_poll_waiting && fio_poll_changes_n < FIO_POLL_CHANGES) {
+    EV_SET(fio_poll_changes + fio_poll_changes_n, fd, EVFILT_READ,
+           EV_ADD | EV_ENABLE | EV_CLEAR | EV_ONESHOT, 0, 0,
+           ((void *)fd2uuid(fd)));
+    ++fio_poll_changes_n;
+    fio_unlock(&fio_poll_changes_lock);
+    return;
+  }
+  fio_unlock(&fio_poll_changes_lock);
+  fio_poll_add_read(fd);
+}
+
 static size_t fio_poll(void) {
   if (evio_fd < 0)
     return -1;
@@ -1937,9 +1960,26 @@ static size_t fio_poll(void) {
     timeout.tv_sec = 1;
     timeout.tv_nsec = 0;
   }
-  /* wait for events and handle them */
-  int active_count =
-      kevent(evio_fd, &arm, n_arm, events, FIO_POLL_MAX_EVENTS, &timeout);
+  /* wait for events and handle them, submitting the queued re-arms; one
+   * whose connection closed meanwhile is dropped */
+  struct kevent changes[FIO_POLL_CHANGES + 1];
+  int n_changes = 0;
+  fio_lock(&fio_poll_changes_lock);
+  for (int i = 0; i < fio_poll_changes_n; ++i) {
+    const intptr_t u = (intptr_t)fio_poll_changes[i].udata;
+    if (uuid_is_valid(u) && uuid_data(u).open)
+      changes[n_changes++] = fio_poll_changes[i];
+  }
+  fio_poll_changes_n = 0;
+  fio_poll_waiting = 1;
+  fio_unlock(&fio_poll_changes_lock);
+  if (n_arm)
+    changes[n_changes++] = arm;
+  int active_count = kevent(evio_fd, changes, n_changes, events,
+                            FIO_POLL_MAX_EVENTS, &timeout);
+  fio_lock(&fio_poll_changes_lock);
+  fio_poll_waiting = 0;
+  fio_unlock(&fio_poll_changes_lock);
 
   if (active_count > 0) {
     for (int i = 0; i < active_count; i++) {
@@ -2267,7 +2307,11 @@ static void fio_poll_rearm(intptr_t uuid, int for_write) {
     if (for_write)
       fio_poll_add_write(fio_uuid2fd(uuid));
     else
+#if FIO_ENGINE_KQUEUE
+      fio_poll_rearm_read(fio_uuid2fd(uuid));
+#else
       fio_poll_add_read(fio_uuid2fd(uuid));
+#endif
   }
   fio_unlock(&uuid_data(uuid).sock_lock);
 }
