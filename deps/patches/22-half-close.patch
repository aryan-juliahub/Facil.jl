+/* The peer's stream ended (`hard`: with an error). What it sent before that
+ * is read first; a read hook may hold input even when the socket is drained,
+ * so its next read reports the end. Otherwise the connection is closed: after
+ * its queued output is sent when it allows half-close, else at once. */
+static inline void fio_peer_eof_in_poll(intptr_t uuid, int unread, int hard) {
+  const uint8_t closing = uuid_data(uuid).close;
+  const uint8_t plain = uuid_data(uuid).rw_hooks == &FIO_DEFAULT_RW_HOOKS;
+  if (!closing && (unread || !plain)) {
+    fio_defer_push_task(deferred_on_data, (void *)uuid, NULL);
+  } else if (!hard && plain && uuid_data(uuid).half_close) {
+    fio_close(uuid);
+  } else if (hard || plain || closing != 1) {
+    fio_force_close_in_poll(uuid);
+  }
+}
