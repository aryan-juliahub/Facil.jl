+
+/**
+ * Like `fio_read`, but with `eof` given, a peer that finished sending (a FIN
+ * with nothing left to read) sets `*eof`, returns 0 and leaves the connection
+ * open; the caller closes it when it has nothing more to send.
+ */
+ssize_t fio_read2(intptr_t uuid, void *buffer, size_t count, int *eof);
+
+/**
+ * With `allow` set, a peer that finished sending is still written to: the
+ * connection closes once its queued output is sent, instead of at once with
+ * the output dropped. Attaching another protocol to the uuid clears it.
+ */
+void fio_half_close_set(intptr_t uuid, int allow);
 
