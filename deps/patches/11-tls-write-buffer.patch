+static void fio_tls_spare_free(void *p) {
+  fio_tls_spare_s *s = p;
+  free(s->buf);
+  free(s);
+}
+static void fio_tls_spare_init(void) {
+  pthread_key_create(&fio_tls_spare_key, fio_tls_spare_free);
