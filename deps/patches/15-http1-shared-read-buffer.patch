+/* Connections share one read buffer per thread while `on_data` runs; only
+ * bytes left unparsed when it returns are moved to the connection's own
+ * block, which is freed again once they are consumed. */
+static __thread uint8_t *h1_scratch;
+
+static int h1_rbuf_acquire(http1pr_s *p) {
+  if (p->rbuf)
+    return 0;
+  if (!h1_scratch && !(h1_scratch = malloc(HTTP_MAX_HEADER_LENGTH)))
+    return -1;
+  p->rbuf = h1_scratch;
+  p->rcap = HTTP_MAX_HEADER_LENGTH;
+  return 0;
+}
+
+static void h1_rbuf_release(intptr_t uuid, http1pr_s *p) {
+  if (p->rbuf == h1_scratch) {
+    if (!p->buf_len) {
+      p->rbuf = NULL;
+      return;
+    }
+    uint8_t *own = malloc(HTTP_MAX_HEADER_LENGTH);
+    if (!own) {
+      p->rbuf = NULL;
+      p->buf_len = 0;
+      fio_close(uuid);
+      return;
+    }
+    memcpy(own, p->rbuf, p->buf_len);
+    p->rbuf = own;
+    p->rown = 1;
+  } else if (p->rown && !p->buf_len && p->rcap <= HTTP_MAX_HEADER_LENGTH) {
+    free(p->rbuf);
+    p->rbuf = NULL;
+    p->rown = 0;
+  }
+}
