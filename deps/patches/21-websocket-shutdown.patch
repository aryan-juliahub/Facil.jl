diff --git a/lib/facil/http/websockets.c b/lib/facil/http/websockets.c
--- a/lib/facil/http/websockets.c
+++ b/lib/facil/http/websockets.c
@@ -531,6 +531,29 @@
   return 0;
 }
 
+static void shutdown_task(intptr_t uuid, fio_protocol_s *pr, void *others) {
+  if (pr->on_shutdown == on_shutdown)
+    on_shutdown(uuid, pr);
+  else if (!others)
+    return;
+  fio_close(uuid);
+}
+
+/* A connection without a protocol to lock is closed directly. */
+static void shutdown_fallback(intptr_t uuid, void *others) {
+  if (others)
+    fio_close(uuid);
+}
+
+/* A WebSocket gets its on_shutdown callback and a 1001 close, as when the
+ * reactor stops. Any other connection is closed when `close_others` is set
+ * and left alone otherwise. Safe from any thread. */
+void websocket_shutdown(intptr_t uuid, int close_others) {
+  fio_defer_io_task(uuid, .type = FIO_PR_LOCK_TASK, .task = shutdown_task,
+                    .udata = close_others ? (void *)1 : NULL,
+                    .fallback = shutdown_fallback);
+}
