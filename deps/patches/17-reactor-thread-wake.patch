+static void fio_poll_dispatch(struct kevent *events, int n, int idle);
+
+/* Set while the last poll filled its event array: ready connections are
+ * waiting in the kernel. */
+static volatile uint8_t fio_poll_backlog;
+
+/* A pool thread that runs out of tasks while connections are waiting polls
+ * without blocking before it sleeps, instead of waiting for the cycle task. */
+static int fio_poll_idle(void) {
+  if (evio_fd < 0 || !fio_poll_backlog)
+    return 0;
+  struct kevent events[FIO_POLL_MAX_EVENTS];
+  const struct timespec zero = {.tv_sec = 0, .tv_nsec = 0};
+  int n = kevent(evio_fd, NULL, 0, events, FIO_POLL_MAX_EVENTS, &zero);
+  fio_poll_backlog = (n == FIO_POLL_MAX_EVENTS);
+  if (n <= 0)
+    return 0;
+  fio_poll_dispatch(events, n, 1);
+  return 1;
+}
+
+/* The cycle task's poll may block until the next timer. A timer event taken
+ * by an idle poll instead schedules the due timers and arms the next one. */
+static void fio_poll_timer_fired(void) {
+  fio_mark_time();
+  fio_timer_schedule();
+  int64_t first_ns = fio_timer_first_ns();
+  if (first_ns >= 0 && first_ns < (int64_t)FIO_POLL_TICK * 1000000LL) {
+    struct kevent arm;
+    EV_SET(&arm, (uintptr_t)-7, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+           NOTE_NSECONDS | NOTE_CRITICAL, first_ns, NULL);
+    kevent(evio_fd, &arm, 1, NULL, 0, NULL);
+  }
+}
+
+static void fio_poll_dispatch(struct kevent *events, int n, int idle) {
+  for (int i = 0; i < n; i++) {
+    if (events[i].filter == EVFILT_TIMER) {
+      if (idle)
+        fio_poll_timer_fired();
+      continue;
+    }
+    const intptr_t uuid = (intptr_t)events[i].udata;
+    if (!uuid_is_valid(uuid) || !uuid_data(uuid).open)
+      continue;
+    // test for event(s) type
+    if (events[i].filter == EVFILT_WRITE) {
+      fio_defer_push_urgent(deferred_on_ready, ((void *)uuid), NULL);
+    } else if (events[i].filter == EVFILT_READ) {
+      fio_defer_push_task(deferred_on_data, (void *)uuid, NULL);
+    }
+    if (events[i].flags & (EV_EOF | EV_ERROR)) {
+      fio_force_close_in_poll(uuid);
+    }
+  }
+}
