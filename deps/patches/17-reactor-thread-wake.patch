+/* Hot shared locks spin briefly before yielding: their holders keep them for
+ * a few instructions, far less than a sleep. */
+static inline void fio_lock_hot(fio_lock_i *lock) {
+  for (size_t i = 0; fio_trylock(lock); ++i) {
+    if (i >= 128) {
+      fio_reschedule_thread();
+      continue;
+    }
+    while (fio_is_locked(lock) && i < 128) {
+#if defined(__aarch64__) || defined(__arm64__)
+      __asm__ volatile("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+      __asm__ volatile("pause");
+#endif
+      ++i;
+    }
+  }
+}
