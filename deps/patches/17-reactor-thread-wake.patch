+/* Timer tasks queued or running: such a timer is back in the list only once
+ * its task ends, so meanwhile the poll wakes every millisecond to look. */
+static volatile size_t fio_timers_inflight;
+
+#ifndef FIO_DEFER_IDLE_WAIT_MS
+#define FIO_DEFER_IDLE_WAIT_MS 100
+#endif
+
+/* Idle pool threads sleep on a condition variable; a task push wakes one.
+ * `woken` counts signals not yet taken, so a burst of pushes wakes each
+ * sleeper once. */
+static pthread_mutex_t fio_idle_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t fio_idle_cond = PTHREAD_COND_INITIALIZER;
+static size_t fio_idle_waiting;
+static size_t fio_idle_woken;
+
+static void fio_idle_wake(void) {
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  if (__atomic_load_n(&fio_idle_waiting, __ATOMIC_SEQ_CST) <=
+      __atomic_load_n(&fio_idle_woken, __ATOMIC_RELAXED))
+    return;
+  pthread_mutex_lock(&fio_idle_lock);
+  if (fio_idle_waiting > fio_idle_woken) {
+    ++fio_idle_woken;
+    pthread_cond_signal(&fio_idle_cond);
+  }
+  pthread_mutex_unlock(&fio_idle_lock);
+}
+
+static void fio_idle_wake_all(void) {
+  pthread_mutex_lock(&fio_idle_lock);
+  fio_idle_woken = fio_idle_waiting;
+  pthread_cond_broadcast(&fio_idle_cond);
+  pthread_mutex_unlock(&fio_idle_lock);
+}
+
+static void fio_idle_wait(void) {
+  pthread_mutex_lock(&fio_idle_lock);
+  __atomic_add_fetch(&fio_idle_waiting, 1, __ATOMIC_SEQ_CST);
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  if (!fio_defer_has_queue() && fio_is_running()) {
+    struct timespec until;
+    clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_nsec += FIO_DEFER_IDLE_WAIT_MS * 1000000L;
+    until.tv_sec += until.tv_nsec / 1000000000L;
+    until.tv_nsec %= 1000000000L;
+    pthread_cond_timedwait(&fio_idle_cond, &fio_idle_lock, &until);
+  }
+  __atomic_sub_fetch(&fio_idle_waiting, 1, __ATOMIC_SEQ_CST);
+  if (fio_idle_woken)
+    --fio_idle_woken;
+  pthread_mutex_unlock(&fio_idle_lock);
+}
