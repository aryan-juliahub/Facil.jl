@@ -842,6 +843,16 @@
 
 /** Returns a human readable string related to the HTTP status number. */
 fio_str_info_s http_status2str(uintptr_t status);
+/** Paths with a segment that starts with a dot are not served. */
+#define HTTP_PUBLIC_DENY_DOTFILES 1
+/** Files that resolve outside the public folder are not served. The folder
+ * must be given as its own real path. */
+#define HTTP_PUBLIC_CONTAIN_SYMLINKS 2
+/** Sets the reason phrase sent for a status in 100..999. Call before the
+ * first connection; the phrase is copied. */
+void http_status_reason_set(uintptr_t status, const char *reason, size_t len);
+/** The HTTP/1.1 status line set by `http_status_reason_set`, if any. */
+fio_str_info_s http_status_line(uintptr_t status);
 
