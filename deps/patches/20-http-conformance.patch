 #undef HTTP_SET_STATUS_STR
 
+/* Sets the reason phrase of a status in 100..999 for every later response.
+ * Not thread safe: call before the first connection. */
+void http_status_reason_set(uintptr_t status, const char *reason, size_t len) {
+  if (status < 100 || status > 999 || (len && !reason))
+    return;
+  char *line = malloc(len + 24);
+  if (!line)
+    return;
+  int n = snprintf(line, 20, "HTTP/1.1 %u ", (unsigned)status);
+  memcpy(line + n, reason, len);
+  memcpy(line + n + len, "\r\n", 3);
+  http_status_reasons[status - 100] =
+      (fio_str_info_s){.data = line + n, .len = len};
+  http_status_lines[status - 100] =
+      (fio_str_info_s){.data = line, .len = (size_t)n + len + 2};
+}
+
+/* The HTTP/1.1 status line set for `status`, or no data when none was set. */
+fio_str_info_s http_status_line(uintptr_t status) {
+  if (status >= 100 && status <= 999)
+    return http_status_lines[status - 100];
+  return (fio_str_info_s){.len = 0, .data = NULL};
+}
+
