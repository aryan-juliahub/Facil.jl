diff --git a/lib/facil/tls/fio_tls_openssl.c b/lib/facil/tls/fio_tls_openssl.c
--- a/lib/facil/tls/fio_tls_openssl.c
+++ b/lib/facil/tls/fio_tls_openssl.c
@@ -17,6 +17,7 @@ Feel free to copy, use and enjoy according to the license provided.
 #if HAVE_OPENSSL
 #include <openssl/bio.h>
 #include <openssl/err.h>
+#include <openssl/pem.h>
 #include <openssl/ssl.h>
 #include <openssl/x509.h>
 
@@ -1377,6 +1378,36 @@ int fio_tls_on_context(fio_tls_s *tls,
 /** Returns the default `SSL_CTX`. A rebuild replaces it. */
 void *fio_tls_ctx(fio_tls_s *tls) { return tls ? tls->ctx : NULL; }
 
+char *fio_tls_peer_cert_pem(intptr_t uuid, size_t *len) {
+  *len = 0;
+  fio_tls_connection_s *c = fio_rw_hook_udata(uuid, &FIO_TLS_HOOKS);
+  if (!c)
+    return NULL;
+  fio_lock(&c->lock);
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+  X509 *x = SSL_get1_peer_certificate(c->ssl);
+#else
+  X509 *x = SSL_get_peer_certificate(c->ssl);
+#endif
+  fio_unlock(&c->lock);
+  if (!x)
+    return NULL;
+  char *out = NULL;
+  BIO *b = BIO_new(BIO_s_mem());
+  if (b && PEM_write_bio_X509(b, x)) {
+    char *data = NULL;
+    long n = BIO_get_mem_data(b, &data);
+    if (n > 0 && (out = malloc((size_t)n + 1))) {
+      memcpy(out, data, (size_t)n);
+      out[n] = 0;
+      *len = (size_t)n;
+    }
+  }
+  BIO_free(b);
+  X509_free(x);
+  return out;
+}
