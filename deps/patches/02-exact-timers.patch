+/* Nanoseconds from now to the first timer: -1 without timers, 0 when one is due. */
+static int64_t fio_timer_first_ns(void) {
+  int64_t ns = -1;
+  fio_lock(&fio_timer_lock);
+  if (fio_ls_embd_any(&fio_timers)) {
+    struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    struct timespec due =
+        FIO_LS_EMBD_OBJ(fio_timer_s, node, fio_timers.next)->due;
+    ns = (int64_t)(due.tv_sec - now.tv_sec) * 1000000000LL +
+         (int64_t)(due.tv_nsec - now.tv_nsec);
+    if (ns < 0)
+      ns = 0;
+  }
+  fio_unlock(&fio_timer_lock);
+  return ns;
+}
