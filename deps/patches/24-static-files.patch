+/* A path segment named `.well-known` (RFC 8615), which dotfile denial allows. */
+static inline int http_is_well_known(const char *p, size_t n) {
+  return n >= 11 && !memcmp(p, ".well-known", 11) && (n == 11 || p[11] == '/');
+}
+
+static int http_date_num(const char *p, int n, int *out) {
+  int v = 0;
+  for (int i = 0; i < n; i++) {
+    if (p[i] == ' ' && !i && n == 2)
+      continue;
+    if (p[i] < '0' || p[i] > '9')
+      return -1;
+    v = v * 10 + (p[i] - '0');
+  }
+  *out = v;
+  return 0;
+}
+
+/* Parses an HTTP-date in any of the three forms of RFC 9110 5.6.7. */
+static int http_date_parse(fio_str_info_s v, time_t *out) {
+  static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+  const char *p = v.data, *day, *mon, *year, *clock;
+  int year_len;
+  if (!p)
+    return -1;
+  const char *comma = memchr(p, ',', v.len);
+  if (comma) {
+    size_t n = v.len - (size_t)(comma + 1 - p);
+    p = comma + 1;
+    if (n == 25 && p[0] == ' ' && p[3] == ' ' && p[7] == ' ' &&
+        p[12] == ' ' && !memcmp(p + 21, " GMT", 4)) {
+      day = p + 1, mon = p + 4, year = p + 8, year_len = 4, clock = p + 13;
+    } else if (n == 23 && p[0] == ' ' && p[3] == '-' && p[7] == '-' &&
+               p[10] == ' ' && !memcmp(p + 19, " GMT", 4)) {
+      day = p + 1, mon = p + 4, year = p + 8, year_len = 2, clock = p + 11;
+    } else {
+      return -1;
+    }
+  } else if (v.len == 24 && p[3] == ' ' && p[7] == ' ' && p[10] == ' ' &&
+             p[19] == ' ') {
+    mon = p + 4, day = p + 8, clock = p + 11, year = p + 20, year_len = 4;
+  } else {
+    return -1;
+  }
+  int d, y, hh, mm, ss, m = -1;
+  for (int i = 0; i < 12; i++)
+    if (!memcmp(months + 3 * i, mon, 3))
+      m = i + 1;
+  if (m < 0 || http_date_num(day, 2, &d) ||
+      http_date_num(year, year_len, &y) || clock[2] != ':' ||
+      clock[5] != ':' || http_date_num(clock, 2, &hh) ||
+      http_date_num(clock + 3, 2, &mm) || http_date_num(clock + 6, 2, &ss))
+    return -1;
+  if (year_len == 2)
+    y += y < 70 ? 2000 : 1900;
+  if (d < 1 || d > 31 || hh > 23 || mm > 59 || ss > 60)
+    return -1;
+  /* days since 1970-01-01 of a proleptic Gregorian date */
+  const int yy = y - (m <= 2);
+  const int era = (yy >= 0 ? yy : yy - 399) / 400;
+  const int yoe = yy - era * 400;
+  const int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  const int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  const int64_t days = (int64_t)era * 146097 + doe - 719468;
+  *out = (time_t)(days * 86400 + hh * 3600 + mm * 60 + ss);
+  return 0;
+}
+
+/* Answers 301 with the path plus a slash for a public-folder directory that
+ * has an index file; -1 (nothing sent) otherwise. */
+static int http_dir_redirect(http_s *h, FIOBJ filename, const char *prefix,
+                             size_t prefix_len, uint8_t flags,
+                             const char *encoded, size_t encoded_len) {
+  if (encoded_len < 2 || encoded[0] != '/' || encoded[1] == '/' ||
+      encoded[1] == '\\')
+    return -1;
+  fiobj_str_write(filename, "/index.html", 11);
+  fio_str_info_s s = fiobj_obj2cstr(filename);
+  struct stat st;
+  if (stat(s.data, &st) || !S_ISREG(st.st_mode))
+    return -1;
+  if (flags & HTTP_PUBLIC_CONTAIN_SYMLINKS) {
+    char real[PATH_MAX];
+    if (!realpath(s.data, real) || strncmp(real, prefix, prefix_len) ||
+        real[prefix_len] != '/')
+      return -1;
+  }
+  FIOBJ loc = fiobj_str_buf(encoded_len + 2);
+  fiobj_str_write(loc, encoded, encoded_len);
+  fiobj_str_write(loc, "/", 1);
+  if (h->query) {
+    fio_str_info_s q = fiobj_obj2cstr(h->query);
+    if (q.len) {
+      fiobj_str_write(loc, "?", 1);
+      fiobj_str_write(loc, q.data, q.len);
+    }
+  }
+  fio_str_info_s l = fiobj_obj2cstr(loc);
+  http_set_header2(h, (fio_str_info_s){.data = (char *)"location", .len = 8},
+                   l);
+  fiobj_free(loc);
+  h->status = 301;
+  http_finish(h);
+  return 0;
+}
