+/* Sets the close marker of a still open `uuid` (`value` 2 also overrides a
+ * 1). The uuid is re-checked under the socket lock, so a marker never lands
+ * on the next connection to reuse the fd. Returns 1 when set, 0 for a stale
+ * uuid and -1 when the lock is busy and `wait` is 0. */
+static int fio_mark_close(intptr_t uuid, uint8_t value, uint8_t wait) {
+  if (!uuid_is_valid(uuid))
+    return 0;
+  if (wait) {
+    fio_lock(&uuid_data(uuid).sock_lock);
+  } else {
+    size_t i = 0;
+    while (fio_trylock(&uuid_data(uuid).sock_lock))
+      if (++i >= 1024)
+        return -1;
+  }
+  const int ok = uuid_is_valid(uuid) && uuid_data(uuid).open;
+  if (ok && (value == 2 || !uuid_data(uuid).close))
+    uuid_data(uuid).close = value;
+  fio_unlock(&uuid_data(uuid).sock_lock);
+  return ok;
+}
+
+/* The caller may hold the socket lock (a flush in progress), so the marker
+ * is retried from a task rather than waited for. */
+static void deferred_close_mark(void *uuid, void *ignr) {
+  switch (fio_mark_close((intptr_t)uuid, 1, 0)) {
+  case -1:
+    fio_defer_push_urgent(deferred_close_mark, uuid, NULL);
+    break;
+  case 1:
+    fio_force_event((intptr_t)uuid, FIO_EVENT_ON_READY);
+    break;
+  }
+  (void)ignr;
+}
