+/* Re-arms reading after `on_data` unless the connection was suspended. The
+ * `scheduled` flag is taken under the socket lock with the uuid re-checked,
+ * so a task of a closed connection never takes the flag of the fd's next one. */
+static void fio_poll_rearm_unless_suspended(intptr_t uuid) {
+  if (!uuid_is_valid(uuid))
+    return;
+  fio_lock(&uuid_data(uuid).sock_lock);
+  if (uuid_is_valid(uuid) && uuid_data(uuid).open &&
+      !fio_trylock(&uuid_data(uuid).scheduled))
+#if FIO_ENGINE_KQUEUE
+    fio_poll_rearm_read(fio_uuid2fd(uuid));
+#else
+    fio_poll_add_read(fio_uuid2fd(uuid));
+#endif
+  fio_unlock(&uuid_data(uuid).sock_lock);
+}
