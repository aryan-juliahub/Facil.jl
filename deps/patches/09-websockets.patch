+/**
+ * Unlinks queued packets that were written with `dealloc`, oldest first,
+ * until the pending bytes fall to `target` or less. The packet at the head of
+ * the queue may be partly sent and is never dropped. Returns the count.
+ */
+size_t fio_pending_drop(intptr_t uuid, void (*dealloc)(void *), size_t target) {
+  if (!uuid_is_valid(uuid))
+    return 0;
+  fio_packet_s *dropped = NULL;
+  size_t count = 0;
+  fio_lock(&uuid_data(uuid).sock_lock);
+  if (uuid_is_valid(uuid) && uuid_data(uuid).packet) {
+    fio_packet_s **pos = &uuid_data(uuid).packet->next;
+    while (*pos && uuid_data(uuid).pending_bytes > target) {
+      fio_packet_s *p = *pos;
+      if (p->dealloc != dealloc) {
+        pos = &p->next;
+        continue;
+      }
+      *pos = p->next;
+      const size_t left = fio_packet_remaining(p);
+      uuid_data(uuid).pending_bytes -=
+          left < uuid_data(uuid).pending_bytes ? left
+                                               : uuid_data(uuid).pending_bytes;
+      fio_atomic_sub(&uuid_data(uuid).packet_count, 1);
+      p->next = dropped;
+      dropped = p;
+      ++count;
+    }
+    if (!*pos)
+      uuid_data(uuid).packet_last = pos;
+  }
+  fio_unlock(&uuid_data(uuid).sock_lock);
+  while (dropped) {
+    fio_packet_s *tmp = dropped;
+    dropped = dropped->next;
+    fio_packet_free(tmp);
+  }
+  return count;
+}
