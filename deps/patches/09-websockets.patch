+/**
+ * Writes the buffers to the socket now when nothing is queued ahead of them,
+ * and queues a copy of whatever the socket did not take. The caller keeps
+ * ownership of the buffers. Returns 0, or -1 when the connection is gone.
+ */
+ssize_t fio_writev_now(intptr_t uuid, const struct iovec *iov_, int n) {
+  struct iovec iov[8];
+  if (!uuid_is_valid(uuid) || n > 8)
+    goto error;
+  size_t total = 0;
+  for (int i = 0; i < n; ++i) {
+    iov[i] = iov_[i];
+    total += iov[i].iov_len;
+  }
+  fio_lock(&uuid_data(uuid).sock_lock);
+  if (!uuid_is_valid(uuid)) {
+    fio_unlock(&uuid_data(uuid).sock_lock);
+    goto error;
+  }
+  const uint8_t was_empty = !uuid_data(uuid).packet;
+  int first = 0;
+  if (was_empty && uuid_data(uuid).rw_hooks == &FIO_DEFAULT_RW_HOOKS) {
+    ssize_t w;
+    do {
+      w = writev(fio_uuid2fd(uuid), iov, n);
+    } while (w < 0 && errno == EINTR);
+    if (w > 0) {
+      total -= (size_t)w;
+      while (first < n && (size_t)w >= iov[first].iov_len)
+        w -= iov[first++].iov_len;
+      if (first < n) {
+        iov[first].iov_base = (uint8_t *)iov[first].iov_base + w;
+        iov[first].iov_len -= w;
+      }
+    }
+  }
+  if (total) {
+    const uint8_t big = total >= (FIO_MEMORY_BLOCK_ALLOC_LIMIT >> 1);
+    uint8_t *buf = big ? malloc(total) : fio_malloc(total);
+    FIO_ASSERT_ALLOC(buf);
+    size_t pos = 0;
+    for (int i = first; i < n; ++i) {
+      memcpy(buf + pos, iov[i].iov_base, iov[i].iov_len);
+      pos += iov[i].iov_len;
+    }
+    fio_packet_s *packet = fio_packet_alloc();
+    *packet = (fio_packet_s){
+        .length = total,
+        .data.buffer = buf,
+        .write_func = fio_sock_write_buffer,
+        .dealloc = big ? free : fio_free,
+    };
+    *uuid_data(uuid).packet_last = packet;
+    uuid_data(uuid).packet_last = &packet->next;
+    fio_atomic_add(&uuid_data(uuid).packet_count, 1);
+    uuid_data(uuid).pending_bytes += total;
+  }
+  fio_unlock(&uuid_data(uuid).sock_lock);
+  touchfd(fio_uuid2fd(uuid));
+  if (total && was_empty) {
+    if (uuid_data(uuid).rw_hooks == &FIO_DEFAULT_RW_HOOKS)
+      fio_poll_rearm(uuid, 1);
+    else
