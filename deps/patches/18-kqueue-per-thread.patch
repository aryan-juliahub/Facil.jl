+    fio_kq_box[i].lock = FIO_LOCK_INIT;
+    struct kevent u;
+    EV_SET(&u, FIO_KQ_WAKE_IDENT, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, NULL);
+    fio_kq_apply(fio_kq[i], &u, 1);
+  }
+  fio_kq_n = n;
+  for (size_t fd = 0; fd <= fio_data->max_protocol_fd; ++fd)
