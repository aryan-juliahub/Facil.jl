+  struct kevent changes[FIO_KQ_LOCAL_CHANGES * 2 + 1];
+  struct kevent events[FIO_POLL_MAX_EVENTS];
+  int cls[FIO_KQ_LOCAL_CHANGES];
+  int n = fio_kq_take_local(changes), n_cls = 0, more;
+  fio_lock(&b->lock);
+  int j = 0;
+  for (; j < b->n_chg && n < FIO_KQ_LOCAL_CHANGES * 2; ++j)
+    n = fio_kq_keep(fio_kq[me], b->chg + j, changes, n);
+  if (j) {
+    memmove(b->chg, b->chg + j, (b->n_chg - j) * sizeof(*b->chg));
+    b->n_chg -= j;
+  }
+  for (j = 0; j < b->n_cls && n_cls < FIO_KQ_LOCAL_CHANGES; ++j)
+    cls[n_cls++] = b->cls[j];
+  if (j) {
+    memmove(b->cls, b->cls + j, (b->n_cls - j) * sizeof(*b->cls));
+    b->n_cls -= j;
+  }
+  more = b->n_chg || b->n_cls;
+  if (sleep && !more) {
+    b->sleeping = 1;
+    b->woken = 0;
+  }
+  fio_unlock(&b->lock);
