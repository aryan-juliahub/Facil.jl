+  FIO_ASSERT_ALLOC(fio_kq && fio_kq_box);
+  fio_kq[0] = evio_fd;
+  for (int i = 1; i < n; ++i) {
+    fio_kq[i] = kqueue();
+    if (fio_kq[i] == -1) {
