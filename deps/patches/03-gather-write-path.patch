+ * Finished packets are moved to `done` for the caller to free once the
+ * socket lock is released. Returns what writev returned. */
+static ssize_t fio_sock_gather_unsafe(int fd, fio_packet_s **done,
+                                      size_t *offered) {
+  struct iovec iov[FIO_GATHER_IOV];
+  int n = 0;
+  size_t total = 0;
+  for (fio_packet_s *p = fd_data(fd).packet;
+       p && p->write_func == fio_sock_write_buffer &&
+       n + 3 <= FIO_GATHER_IOV && total < FIO_GATHER_BYTES;
+       p = p->next) {
+    if (p->pre_off < p->pre_len) {
+      iov[n].iov_base = p->pre + p->pre_off;
+      iov[n++].iov_len = p->pre_len - p->pre_off;
+    }
+    if (p->length) {
